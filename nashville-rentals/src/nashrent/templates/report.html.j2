<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>nashrent — {{ summary }}</title>
<style>
  :root {
    --bg: #fbfaf8; --panel: #ffffff; --ink: #1b1a18; --muted: #6b6862;
    --line: #e5e1da; --accent: #2f6f4f; --warn: #9a6b00; --bad: #9a3412;
    --chip: #f0ede7;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161513; --panel: #1e1d1a; --ink: #ecebe7; --muted: #9b978e;
      --line: #302e2a; --accent: #79c79b; --warn: #d9a441; --bad: #e0785a;
      --chip: #26251f;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1.25rem 4rem; background: var(--bg); color: var(--ink);
    font: 15px/1.55 ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 1080px; margin: 0 auto; }
  h1 { font-size: 1.4rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .sub { color: var(--muted); font-size: .9rem; margin-bottom: 1.75rem; }
  .card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 1rem 1.1rem; margin-bottom: .85rem;
  }
  .head { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  .rank { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 1.7rem; }
  .score {
    font-size: 1.5rem; font-weight: 650; font-variant-numeric: tabular-nums;
    color: var(--accent); min-width: 3rem;
  }
  .score small { font-size: .7rem; color: var(--muted); font-weight: 400; }
  .title { font-weight: 600; flex: 1 1 18rem; }
  .title a { color: inherit; text-decoration: none; }
  .title a:hover { text-decoration: underline; }
  .facts { color: var(--muted); font-size: .88rem; margin: .35rem 0 .6rem; }
  .facts b { color: var(--ink); font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .6rem; }
  .chip {
    background: var(--chip); border-radius: 99px; padding: .12rem .6rem;
    font-size: .78rem; color: var(--muted);
  }
  .chip.new { background: var(--accent); color: var(--bg); font-weight: 600; }
  .chip.drop { background: var(--warn); color: var(--bg); font-weight: 600; }
  table.bd { width: 100%; border-collapse: collapse; font-size: .82rem; }
  table.bd td { padding: .18rem .4rem .18rem 0; vertical-align: middle; }
  table.bd td.n { color: var(--muted); width: 8.5rem; }
  table.bd td.v { width: 7rem; }
  table.bd td.note { color: var(--muted); }
  .bar { display: inline-block; height: 7px; border-radius: 4px; background: var(--accent); min-width: 2px; }
  .bar-bg { display: inline-block; width: 6rem; height: 7px; border-radius: 4px; background: var(--chip); }
  .warn { color: var(--warn); font-size: .82rem; margin-top: .5rem; }
  .scroll { overflow-x: auto; }
  details summary { cursor: pointer; color: var(--muted); font-size: .85rem; }
  .foot { color: var(--muted); font-size: .8rem; margin-top: 2.5rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .err { color: var(--bad); font-size: .85rem; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Nashville rentals — {{ summary }}</h1>
  <div class="sub">
    Generated {{ generated }} ·
    budget {{ config.budget.max_price | money }} (stretch {{ config.budget.stretch_price | money }}) ·
    {{ config.requirements.min_beds | int }}+ bed ·
    target move-in {{ config.requirements.target_move_in or "unset" }}
  </div>

  {% if result.source_errors %}
    <div class="card">
      {% for name, err in result.source_errors.items() %}
        <div class="err"><b>{{ name }}</b> failed: {{ err[:200] }}</div>
      {% endfor %}
    </div>
  {% endif %}

  {% for listing in listings %}
    <div class="card">
      <div class="head">
        <span class="rank">{{ loop.index }}</span>
        <span class="score">{{ "%.0f" | format(listing.score.total) }}<small>/100</small></span>
        <span class="title">
          <a href="{{ listing.url }}" target="_blank" rel="noopener">
            {{ listing.title or listing.url }}
          </a>
        </span>
      </div>

      <div class="chips">
        {% if listing.key in new_keys %}<span class="chip new">NEW</span>{% endif %}
        {% if listing.key in drops %}
          <span class="chip drop">
            {{ drops[listing.key][0] | money }} → {{ drops[listing.key][1] | money }}
          </span>
        {% endif %}
        <span class="chip">{{ listing.source }}</span>
        <span class="chip">{{ listing.home_type.value }}</span>
        {% if listing.geo.neighborhood %}<span class="chip">{{ listing.geo.neighborhood }}</span>{% endif %}
        {% if listing.available_date %}<span class="chip">avail {{ listing.available_date }}</span>{% endif %}
        <span class="chip">{{ "%.0f" | format(listing.score.coverage * 100) }}% data</span>
      </div>

      <div class="facts">
        <b>{{ listing.price | money }}</b>/mo ·
        <b>{{ listing.beds | num }}</b> bd ·
        <b>{{ listing.baths | num }}</b> ba ·
        <b>{{ listing.sqft | num }}</b> sqft
        {%- if listing.price_per_sqft %} · ${{ "%.2f" | format(listing.price_per_sqft) }}/sqft{% endif %}
        {%- if listing.address %} · {{ listing.address }}{% endif %}
      </div>

      <div class="scroll">
        <table class="bd">
          {% for c in listing.score.components | sort(attribute='points', reverse=true) %}
            <tr>
              <td class="n">{{ c.name.replace('_', ' ') }}</td>
              <td class="v">
                <span class="bar-bg">
                  <span class="bar" style="width: {{ (c.normalized * 6) | round(2) }}rem"></span>
                </span>
              </td>
              <td class="v">{{ "%.1f" | format(c.points) }} / {{ "%.0f" | format(c.weight) }}</td>
              <td class="note">{{ c.note }}</td>
            </tr>
          {% endfor %}
        </table>
      </div>

      {% for w in listing.score.warnings %}
        <div class="warn">⚠ {{ w }}</div>
      {% endfor %}

      {% if listing.description %}
        <details>
          <summary>listing text</summary>
          <p style="white-space: pre-wrap; font-size:.85rem; color: var(--muted)">{{ listing.description[:1800] }}</p>
        </details>
      {% endif %}
    </div>
  {% endfor %}

  {% if not listings %}
    <div class="card">Nothing passed the hard filters this run.</div>
  {% endif %}

  <div class="foot">
    Sources this run: {% for name, n in result.per_source.items() %}{{ name }} ({{ n }}){% if not loop.last %} · {% endif %}{% endfor %}.
    {{ result.enriched }} listings enriched, {{ result.gone }} marked gone.<br>
    Safety figures derive from Metro Nashville PD incident data published on data.nashville.gov.
    They count reported incidents in an 800m radius and are inflated in commercial
    districts, where the daytime population dwarfs the residential one.
  </div>
</div>
</body>
</html>
